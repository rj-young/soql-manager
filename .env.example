# SOQL Manager environment variables.
# Copy to .env.local and fill in values from your Salesforce Connected App.
# .env.local is gitignored; never commit secrets.

# Salesforce Connected App credentials (Setup -> App Manager -> New Connected App).
# See docs/connected-app-setup.md for setup screenshots (TBD: created in a later task).
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Salesforce REST API version. Must be GA (no Beta / Pre-release).
# Pinned per docs/api-version.md. Verify against your dev org's
# https://<your-domain>.my.salesforce.com/services/data/ before any non-trivial use.
SF_API_VERSION=66.0

# Loopback redirect port for OAuth 2.0 Web Server flow.
# Hardcoded to 1717 to match `sf` CLI convention. EADDRINUSE fails loudly
# (no auto-fallback) per PRD section 10.
SF_OAUTH_REDIRECT_PORT=1717
